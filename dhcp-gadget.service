[Unit]
Description=DHCP Gadget Daemon
After=network-online.target dbus.service
Requires=dbus.service
Wants=network-online.target

[Service]
Type=dbus
BusName=org.dhcp_gadget1
EnvironmentFile=-/etc/default/dhcp-gadget

Environment=CONFIG=/etc/dhcp-gadget/config.conf
Environment=LOG_LEVEL=info
ExecStart=/opt/dhcp-gadget/dhcp-gadgetd --config ${CONFIG} --log-level ${LOG_LEVEL}

# Run with only the network capabilities needed for raw DHCP handling.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# Basic service sandboxing.
NoNewPrivileges=true
User=dhcp-gadget
Group=dhcp-gadget
PrivateDevices=true
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

[Unit]
Description=DHCP Server for USB Gadget Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/dhcp-gadget

Environment=CONFIG=/etc/dhcp-gadget/config.json
Environment=LOG_LEVEL=INFO
Environment=BRIDGE=
ExecStart=/usr/bin/python3 /opt/dhcp-gadget/dhcp_server.py --bridge=${BRIDGE} --config ${CONFIG} --log-level ${LOG_LEVEL}

# Run with only the network capabilities needed for raw DHCP handling.
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE

# Basic service sandboxing.
DynamicUser=true
PrivateDevices=true
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
MemoryDenyWriteExecute=true
Restart=always
RestartSec=1

# Stop probing cache
Environment=XDG_CACHE_HOME=
Environment=XDG_CONFIG_HOME=

[Install]
WantedBy=multi-user.target
